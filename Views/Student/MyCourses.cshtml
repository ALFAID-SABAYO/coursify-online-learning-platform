@model IEnumerable<Coursify.Models.Enrollment>
@{
    ViewData["Title"] = "My Courses";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">My Courses</h2>
        <p class="text-muted mb-0">Track your progress and continue learning.</p>
    </div>
    <a class="btn btn-course btn-course-primary"
       asp-action="BrowseCourses">
        <i class="fas fa-search me-1"></i>Browse Courses
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not enrolled in any courses yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0" style="border-radius:14px;">

                    @if (!string.IsNullOrEmpty(e.Course.ThumbnailUrl))
                    {
                        <img src="@e.Course.ThumbnailUrl"
                             class="card-img-top"
                             style="height:180px;object-fit:cover;border-radius:14px 14px 0 0;">
                    }

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="fw-bold mb-0">@e.Course.Title</h5>
                            <span class="badge bg-secondary">@e.Course.Level</span>
                        </div>

                        <p class="text-muted small">
                            <i class="fas fa-user-tie me-1"></i>@e.Course.Teacher.Name
                        </p>

                        <p class="text-truncate">@e.Course.Description</p>

                        <!-- Progress -->
                        <div class="progress mb-2" style="height:10px;border-radius:10px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width:@e.ProgressPercentage%;background:linear-gradient(90deg,#2563eb,#3b82f6)">
                            </div>
                        </div>

                        <small class="text-muted d-block mb-3">
                            <i class="fas fa-chart-line me-1"></i>
                            @Math.Round(e.ProgressPercentage, 1)% completed
                        </small>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 justify-content-between">

                            @{
                                var firstLesson = e.Course?.Modules?
                                .OrderBy(m => m.OrderNo)
                                .SelectMany(m => m.Lessons.OrderBy(l => l.OrderNo))
                                .FirstOrDefault();
                            }

                            @if (firstLesson != null)
                            {
                                <a class="btn btn-course btn-course-primary btn-sm"
                                   asp-action="WatchLesson"
                                   asp-route-enrollmentId="@e.Id"
                                   asp-route-lessonId="@firstLesson.Id">
                                    <i class="fas fa-play me-1"></i>Continue
                                </a>

                                <a class="btn btn-course btn-course-outline btn-sm"
                                   asp-action="CourseContent"
                                   asp-route-enrollmentId="@e.Id">
                                    <i class="fas fa-list me-1"></i>Lessons
                                </a>
                            }

                            @if (e.HasCertificate && e.ProgressPercentage >= 80)
                            {
                                <div class="d-flex gap-2">
                                    <a class="btn btn-course btn-course-success btn-sm"
                                       asp-action="ViewCertificate"
                                       asp-route-enrollmentId="@e.Id">
                                        <i class="fas fa-certificate me-1"></i>View
                                    </a>

                                    <a class="btn btn-course btn-course-outline btn-sm"
                                       asp-action="DownloadCertificate"
                                       asp-route-enrollmentId="@e.Id">
                                        <i class="fas fa-download me-1"></i>Download
                                    </a>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-course btn-course-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#progressModal-@e.Id">
                                    <i class="fas fa-lock me-1"></i>Generate Certificate
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal -->
            <div class="modal fade" id="progressModal-@e.Id">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h5 class="modal-title">Certificate Locked</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            Complete at least <strong>80%</strong> to unlock certificate.
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .btn-course {
        border-radius: 10px;
        padding: 6px 14px;
        font-weight: 500;
        transition: all .25s ease;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

        .btn-course:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
        }

    .btn-course-primary {
        background: linear-gradient(135deg,#2563eb,#3b82f6);
        color: #fff;
        border: none;
    }

    .btn-course-outline {
        border: 1px solid #2563eb;
        color: #2563eb;
        background: #fff;
    }

        .btn-course-outline:hover {
            background: #2563eb;
            color: #fff;
        }

    .btn-course-success {
        background: linear-gradient(135deg,#16a34a,#22c55e);
        color: #fff;
        border: none;
    }

    .btn-course-warning {
        background: linear-gradient(135deg,#f59e0b,#fbbf24);
        border: none;
        color: #1f2937;
    }
</style>
