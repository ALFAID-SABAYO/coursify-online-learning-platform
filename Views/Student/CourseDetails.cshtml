@model Coursify.Models.Course
@{
    ViewData["Title"] = Model?.Title ?? "Course Details";
    var isEnrolled = ViewBag.IsEnrolled as bool? ?? false;
}

<div class="mb-4">
    <a class="btn btn-link" asp-action="BrowseCourses">← Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h2 class="mb-2">@Model.Title</h2>
                <p class="text-muted mb-2">By @Model.Teacher.Name</p>
                <p>@Model.Description</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Curriculum</h5>
                    @if (isEnrolled && ViewBag.Enrollment != null)
                    {
                        <span class="badge bg-primary">Enrolled</span>
                    }
                </div>
                @if (Model.Modules == null || !Model.Modules.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        @if (isEnrolled)
                        {
                            <span>Course content is being prepared. Check back soon!</span>
                        }
                        else
                        {
                            <span>Modules not available. Enroll to access course content when it's ready.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="accordion" id="modulesAccordion">
                        @{
                            var index = 0;
                        }
                        @foreach (var module in Model.Modules.OrderBy(m => m.OrderNo))
                        {
                            var collapseId = $"module-{index}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@index">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                        @module.Title
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@index" data-bs-parent="#modulesAccordion">
                                    <div class="accordion-body">
                                        @if (module.Lessons == null || !module.Lessons.Any())
                                        {
                                            <p class="text-muted mb-0">No lessons yet.</p>
                                        }
                                        else
                                        {
                                            <ul class="list-group list-group-flush">
                                                @foreach (var lesson in module.Lessons.OrderBy(l => l.OrderNo))
                                                {
                                                    <li class="list-group-item">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span>
                                                                @if (lesson.IsPreview)
                                                                {
                                                                    <span class="badge bg-info me-2">Preview</span>
                                                                }
                                                                @lesson.Title
                                                            </span>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (lesson.Duration.HasValue)
                                                                {
                                                                    <small class="text-muted">@lesson.Duration.Value min</small>
                                                                }
                                                                @if (isEnrolled && ViewBag.Enrollment != null)
                                                                {
                                                                    <a asp-action="WatchLesson" asp-route-enrollmentId="@ViewBag.Enrollment.Id" asp-route-lessonId="@lesson.Id" class="btn btn-sm btn-outline-primary">
                                                                        <i class="fas fa-play me-1"></i>Watch
                                                                    </a>
                                                                }
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>
                            index++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0">$@Model.Price</h4>
                    <span class="badge bg-secondary">@Model.Level</span>
                </div>
                <p class="text-muted mb-3">Language: @Model.Language</p>

                @if (isEnrolled)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>You are enrolled in this course.
                    </div>
                    
                        var firstLesson = Model.Modules?.FirstOrDefault()?.Lessons?.OrderBy(l => l.OrderNo).FirstOrDefault();
                        var hasVideoUrl = !string.IsNullOrEmpty(Model.PreviewVideoUrl);
                    
                    @if (firstLesson != null && ViewBag.Enrollment != null)
                    {
                        <a class="btn btn-primary w-100 mb-2" asp-action="WatchLesson" asp-route-enrollmentId="@ViewBag.Enrollment.Id" asp-route-lessonId="@firstLesson.Id">
                            <i class="fas fa-play me-2"></i>Start Learning
                        </a>
                        <a class="btn btn-outline-primary w-100 mb-2" asp-action="CourseContent" asp-route-enrollmentId="@ViewBag.Enrollment.Id">
                            <i class="fas fa-list me-2"></i>View All Lessons
                        </a>
                    }
                    else if (hasVideoUrl && ViewBag.Enrollment != null)
                    {
                        <a class="btn btn-primary w-100 mb-2" asp-action="WatchCourse" asp-route-enrollmentId="@ViewBag.Enrollment.Id">
                            <i class="fas fa-play me-2"></i>Watch Course Video
                        </a>
                    }
                    <a class="btn btn-outline-primary w-100" asp-action="MyCourses">Go to My Courses</a>
                }
                else
                {
                    <a class="btn btn-primary w-100" asp-action="PurchaseCourse" asp-route-courseId="@Model.Id">Enroll Now</a>
                }
            </div>
        </div>
    </div>
</div>







