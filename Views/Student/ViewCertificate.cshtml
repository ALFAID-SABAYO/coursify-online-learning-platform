@model Coursify.Models.Certificate
@{
    ViewData["Title"] = "Certificate";
}

<div class="mb-4">
    <a class="btn btn-link" asp-action="MyCourses">← Back to courses</a>
    <h2 class="mt-3">Certificate of Completion</h2>
</div>

@if (Model == null)
{
    <div class="alert alert-warning">Certificate not found.</div>
}
else
{
    <div class="card shadow-lg border-0 mx-auto"
         style="max-width: 900px; border-radius: 20px; background: linear-gradient(135deg, #f0f4ff, #ffffff);
                    padding: 50px 40px 40px; background-image: url('~/images/certificate-bg.png');
                    background-size: cover; background-repeat: no-repeat; position: relative;">

        <!-- Title / Platform Name -->
        <div class="text-center mb-4">
            <h1 class="fw-bold" style="font-family: 'Georgia', serif; color: #4a4a4a;">Coursify</h1>
            <p class="text-muted mb-0">Online Learning Platform</p>
        </div>

        <hr class="mb-4" style="border-top: 3px solid #6c63ff;" />

        <!-- Certificate Body -->
        <div class="text-center">
            <h2 class="fw-bold mb-3" style="color: #333;">Certificate of Completion</h2>
            <p class="fs-5 mb-1">This is proudly presented to</p>
            <h3 class="fw-bold mb-3">@Model.Enrollment.Student.Name</h3>
            <p class="fs-5 mb-1">for successfully completing the course</p>
            <h4 class="fw-bold mb-3" style="color: #6c63ff;">@Model.Enrollment.Course.Title</h4>
            <p class="text-muted mb-4">Issued on <strong>@Model.IssuedDate.ToString("MMMM dd, yyyy")</strong></p>
        </div>

        <!-- Footer / Certificate Info -->
        <div class="d-flex justify-content-between mt-5">
            <div>
                <p class="mb-0 text-muted">Certificate ID: <strong>@Model.UniqueCode</strong></p>
            </div>
            <div class="text-end">
                <p class="mb-0">Verified by <strong>Coursify Team</strong></p>
            </div>
        </div>

        <!-- Download Button -->
        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg" asp-action="DownloadCertificate" asp-route-enrollmentId="@Model.EnrollmentId">
                <i class="fas fa-download me-1"></i> Download PDF Certificate
            </a>
        </div>
    </div>
}
