@model Coursify.Models.Course
@{
    ViewData["Title"] = "Create Course";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Create Course</h2>
        <p class="text-muted mb-0">Publish a new course for your students.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Dashboard">Back</a>
</div>

<form asp-action="CreateCourse" method="post" enctype="multipart/form-data" class="card shadow-sm border-0 p-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" placeholder="Course title" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Price" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Level" class="form-label"></label>
            <input asp-for="Level" class="form-control" placeholder="Beginner / Intermediate / Advanced" required />
            <span asp-validation-for="Level" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Language" class="form-label"></label>
            <input asp-for="Language" class="form-control" placeholder="e.g. English" required />
            <span asp-validation-for="Language" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your course" required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Course Thumbnail (Upload from device)</label>
            <input type="file" name="thumbnail" class="form-control" accept="image/*" />
            <small class="text-muted">Upload an image file from your device</small>
        </div>
        <div class="col-md-6">
            <label class="form-label">Course Video URL <span class="text-danger">*</span></label>
            <input asp-for="PreviewVideoUrl" class="form-control" placeholder="YouTube link or direct video URL" required />
            <small class="text-muted">
                <i class="fas fa-info-circle me-1"></i>Enter YouTube link (e.g., https://youtube.com/watch?v=...) or direct video URL. This will be the main course video.
            </small>
            <span asp-validation-for="PreviewVideoUrl" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsPublished" class="form-check-input" />
                <label class="form-check-label" asp-for="IsPublished">Publish immediately</label>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Create course</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




