@model IEnumerable<Coursify.Models.Course>

@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">My Courses</h2>
        <p class="text-muted mb-0">Create, manage modules, and track students</p>
    </div>

    <a class="btn btn-primary btn-lg shadow-sm"
       asp-action="CreateCourse">
        + Create New Course
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        You haven't created any courses yet.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm course-card">

                    <div class="card-body">
                        <h5 class="fw-bold">@course.Title</h5>

                        <p class="text-muted small mb-1">
                            @course.Language • @course.Level
                        </p>

                        <p class="text-truncate">
                            @course.Description
                        </p>
                    </div>

                    <div class="card-footer bg-white border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">$@course.Price</span>

                            <div class="btn-group">
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="EditCourse"
                                   asp-route-id="@course.Id">
                                    Edit
                                </a>

                                <a class="btn btn-outline-primary btn-sm"
                                   asp-action="CourseStudents"
                                   asp-route-courseId="@course.Id">
                                    Students
                                </a>

                                <!-- 🔥 MAIN BUTTON -->
                                <a class="btn btn-success btn-sm"
                                   asp-action="CourseDetails"
                                   asp-route-id="@course.Id">
                                    Manage Course
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}

<style>
    .course-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        }
</style>
