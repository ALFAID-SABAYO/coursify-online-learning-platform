@model Coursify.Models.Module

@{
    ViewData["Title"] = "Add Module";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Add New Module</h3>
        </div>
        <div class="card-body">
            <form asp-action="AddModule" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="CourseId" value="@ViewBag.CourseId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Module Title</label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter module title" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Write a short description..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="OrderNo" class="form-label fw-bold">Order Number</label>
                    <input asp-for="OrderNo" type="number" class="form-control" placeholder="Module order in course" />
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success btn-lg shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Add Module
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
