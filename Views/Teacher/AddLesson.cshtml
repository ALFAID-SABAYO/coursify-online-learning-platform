@model Coursify.Models.Lesson

@{
    ViewData["Title"] = "Add Lesson";
    var moduleId = ViewBag.ModuleId as int? ?? Model.ModuleId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Add Lesson</h2>
        <p class="text-muted mb-0">Add a lesson using YouTube video link or upload a video file</p>
    </div>
    <a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
</div>

<form asp-action="AddLesson" method="post" enctype="multipart/form-data" class="card shadow-sm border-0 p-4">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ModuleId" value="@moduleId" />

    <div class="row g-3">

        <!-- Lesson Title -->
        <div class="col-12">
            <label asp-for="Title" class="form-label fw-bold">
                Lesson Title <span class="text-danger">*</span>
            </label>
            <input asp-for="Title"
                   class="form-control"
                   placeholder="e.g. Introduction to React"
                   required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- Description -->
        <div class="col-12">
            <label asp-for="Description" class="form-label fw-bold">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"
                      placeholder="Brief description of this lesson"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- YouTube Link -->
        <div class="col-12">
            <label asp-for="VideoUrl" class="form-label fw-bold">YouTube Video Link</label>
            <input asp-for="VideoUrl"
                   class="form-control"
                   placeholder="https://www.youtube.com/watch?v=XXXX" />
            <small class="text-muted">Paste full YouTube video link (optional if uploading video file)</small>
            <span asp-validation-for="VideoUrl" class="text-danger"></span>
        </div>

        <!-- Upload Video File -->
        <div class="col-12">
            <label for="videoFile" class="form-label fw-bold">Upload Video (Optional if YouTube link provided)</label>
            <input type="file"
                   class="form-control"
                   id="videoFile"
                   name="videoFile"
                   accept=".mp4,.webm,.ogg,.mov,.avi" />
            <small class="text-muted">Allowed formats: MP4, WebM, OGG, MOV, AVI (max 500MB)</small>
        </div>

        <!-- Duration & Order Number -->
        <div class="col-md-6">
            <label asp-for="Duration" class="form-label fw-bold">Duration (minutes)</label>
            <input asp-for="Duration"
                   class="form-control"
                   type="number"
                   min="1"
                   placeholder="e.g. 15" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OrderNo" class="form-label fw-bold">Order Number</label>
            <input asp-for="OrderNo"
                   class="form-control"
                   type="number"
                   min="1"
                   value="1" />
            <span asp-validation-for="OrderNo" class="text-danger"></span>
        </div>

        <!-- Preview Checkbox -->
        <div class="col-12">
            <div class="form-check mt-2">
                <input asp-for="IsPreview" class="form-check-input" type="checkbox" />
                <label asp-for="IsPreview" class="form-check-label">
                    Mark as Preview (Free to watch)
                </label>
            </div>
        </div>

        <!-- Buttons -->
        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-success px-4">
                Add Lesson
            </button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary ms-2">
                Cancel
            </a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
