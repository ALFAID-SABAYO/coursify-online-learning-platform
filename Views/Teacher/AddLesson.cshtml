@model Coursify.Models.Lesson
@{
    ViewData["Title"] = "Add Lesson";
    var moduleId = ViewBag.ModuleId as int? ?? Model.ModuleId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Add Lesson</h2>
        <p class="text-muted mb-0">Add a new lesson with video content.</p>
    </div>
    <a class="btn btn-outline-secondary" href="javascript:history.back()">Back</a>
</div>

<form asp-action="AddLesson" method="post" enctype="multipart/form-data" class="card shadow-sm border-0 p-4">
    <input type="hidden" asp-for="ModuleId" value="@moduleId" />
    
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Title" class="form-label">Lesson Title <span class="text-danger">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="e.g., Introduction to React" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        
        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of this lesson"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Video File <span class="text-danger">*</span></label>
            <input type="file" name="videoFile" class="form-control" accept="video/*" required />
            <small class="text-muted">Upload MP4, WebM, or other video formats (Max 500MB)</small>
            <span class="text-danger field-validation-valid" data-valmsg-for="videoFile" data-valmsg-replace="true"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Duration" class="form-label">Duration (minutes)</label>
            <input asp-for="Duration" class="form-control" type="number" min="1" placeholder="e.g., 15" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="OrderNo" class="form-label">Order Number</label>
            <input asp-for="OrderNo" class="form-control" type="number" min="1" value="1" />
            <span asp-validation-for="OrderNo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <div class="form-check mt-4 pt-3">
                <input asp-for="IsPreview" class="form-check-input" type="checkbox" />
                <label asp-for="IsPreview" class="form-check-label">Mark as Preview (Free to watch)</label>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Add Lesson</button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

