@model IEnumerable<Coursify.Models.Course>
@{
    ViewData["Title"] = "Manage Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Manage Courses</h2>
        <p class="text-muted mb-0">Approve, publish, or remove courses.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Dashboard">Back</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Teacher</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Title</td>
                    <td>@c.Teacher?.Name</td>
                    <td>$@c.Price</td>
                    <td>
                        <span class="badge @(c.IsPublished ? "bg-success" : "bg-secondary")">
                            @(c.IsPublished ? "Published" : "Hidden")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="ToggleCourseStatus" asp-route-id="@c.Id">
                            @(c.IsPublished ? "Unpublish" : "Publish")
                        </a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="DeleteCourse" asp-route-id="@c.Id" onclick="return confirm('Are you sure you want to delete this course? This will also delete all enrollments and related data.');">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>








