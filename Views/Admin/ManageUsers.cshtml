@model IEnumerable<Coursify.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Manage Users</h2>
        <p class="text-muted mb-0">Activate/deactivate or remove users.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Dashboard">Back</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (user.Role == "Teacher")
                        {
                            <a class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-warning")" asp-action="BanTeacher" asp-route-id="@user.Id">
                                @(user.IsActive ? "Ban Teacher" : "Unban Teacher")
                            </a>
                        }
                            @if (user.Role != "Admin")
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="ToggleUserStatus"
                                   asp-route-id="@user.Id">
                                    @(user.IsActive ? "Deactivate" : "Activate")
                                </a>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Protected</span>
                            }

                        @if (user.Role != "Admin")
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-action="DeleteUser" asp-route-id="@user.Id" onclick="return confirm('Are you sure you want to delete this user?');">Delete</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
