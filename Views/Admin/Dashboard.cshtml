@{
    ViewData["Title"] = "Admin Dashboard";
    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
    var totalStudents = ViewBag.TotalStudents as int? ?? 0;
    var totalTeachers = ViewBag.TotalTeachers as int? ?? 0;
    var totalCourses = ViewBag.TotalCourses as int? ?? 0;
    var totalEnrollments = ViewBag.TotalEnrollments as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
    var adminCommission = ViewBag.AdminCommission as decimal? ?? 0;

}

<h2 class="fw-bold mb-4">📊 Admin Dashboard</h2>

<div class="row g-4 mb-4">

    <!-- Users -->
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="mb-1">Total Users</p>
                        <h3 class="fw-bold">@totalUsers</h3>
                    </div>
                    <i class="bi bi-people fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Students -->
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="mb-1">Students</p>
                        <h3 class="fw-bold">@totalStudents</h3>
                    </div>
                    <i class="bi bi-mortarboard fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Teachers -->
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="mb-1">Teachers</p>
                        <h3 class="fw-bold">@totalTeachers</h3>
                    </div>
                    <i class="bi bi-person-badge fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Courses -->
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="mb-1">Courses</p>
                        <h3 class="fw-bold">@totalCourses</h3>
                    </div>
                    <i class="bi bi-journal-bookmark fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="col-md-3">
        <div class="card stat-card bg-dark text-white shadow">
            <div class="card-body">
                <p class="mb-1">Total Revenue</p>
                <h4 class="fw-bold">$ @totalRevenue.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <!-- Commission -->
    <div class="col-md-3">
        <div class="card stat-card bg-secondary text-white shadow">
            <div class="card-body">
                <p class="mb-1">Admin Commission</p>
                <h4 class="fw-bold">$ @adminCommission.ToString("N2")</h4>
            </div>
        </div>
    </div>

</div>

<!-- Enrollments + Actions -->
<div class="card shadow border-0">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <p class="text-muted mb-1">Total Enrollments</p>
            <h3 class="fw-bold">@totalEnrollments</h3>
        </div>
        <div class="btn-group">
            <a class="btn btn-primary px-4" asp-action="ManageUsers">
                <i class="bi bi-people"></i> Manage Users
            </a>
            <a class="btn btn-outline-primary px-4" asp-action="ManageCourses">
                <i class="bi bi-journal"></i> Manage Courses
            </a>
        </div>
    </div>
</div>

<style>
    .stat-card {
        border-radius: 16px;
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
    }
</style>
