@{
    ViewData["Title"] = "Business Stats";
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
    var monthlyRevenue = ViewBag.MonthlyRevenue as decimal? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Business Stats</h2>
        <p class="text-muted mb-0">Platform-wide revenue overview.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Dashboard">Back</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">Total revenue</p>
                <h3 class="mb-0">$@totalRevenue</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">This month</p>
                <h3 class="mb-0">$@monthlyRevenue</h3>
            </div>
        </div>
    </div>
</div>







